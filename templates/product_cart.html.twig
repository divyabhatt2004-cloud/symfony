{% extends 'base.html.twig' %}

{% block body %}
    <section>
        <div class="container">
            <div class="row mt-5 mb-5" id="product_cartTable">
                <div class="text-center">
                    {{ include('tables/product_cartTable.html.twig') }}
                    <div class="row mt-5">
                        <div class="col-4 offset-8">
                            <div class="card mb-5">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="row">
                                                <div class="col-6 text-start">
                                                    <p class="h6 fw-light">Sub-Total</p>
                                                </div>
                                                <div class="col-6 text-end">
                                                    {{ calculation('subtotal') }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="row">
                                                <div class="col-6 text-start">
                                                    <p class="h6 fw-light">Tax</p>
                                                </div>
                                                <div class="col-6 text-end">
                                                    {{ calculation('gst') }}
                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-12">
                                            <div class="row">
                                                <div class="col-6 text-start">
                                                    <p class="h6 fw-light">Grand Total</p>
                                                </div>
                                                <div class="col-6 text-end">
                                                    {{ calculation('total') }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-2 text-end">
                                            <a class="btn btn-success text-white" href="#">Checkout</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}


