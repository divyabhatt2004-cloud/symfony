{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row">
    <div class="col-lg-6 col-md-4">
        <label for="product_name" class="form-label">Product Name</label>
        <div class="mb-3">
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
    </div>
    <div class="col-lg-6 col-md-4">
        <div class="col-lg-12 col-md-8">
            <label for="product_description" class="form-label">Description</label>
            <div class="mb-3">
                {{ form_widget(form.description,) }}
                {{ form_errors(form.description) }}
            </div>
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-lg-6 col-md-4">
        <label for="category" class="form-label">Categories</label>
        <div>
{#            <div class="d-flex m-1">#}
            {{ form_widget(form.category,{'attr':{'class':'form-select'}}) }}
{#            <a href="{{ path('category_create') }}" class="btn btn-success">Create</a>#}
{#            </div>#}
            {{ form_errors(form.category) }}
        </div>
    </div>
    <div class="col-lg-6 col-md-4">
        <label for="quantity" class="form-label">Quantity</label>
        <div>
            {{ form_widget(form.quantity) }}
            {{ form_errors(form.quantity) }}
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-lg-6 col-md-4">
        <label for="price" class="form-label">Price</label>
        <div>
            {{ form_widget(form.price) }}
            {{ form_errors(form.price) }}
        </div>
    </div>
    <div class="col-lg-6 col-md-4">
        <label for="gst" class="form-label">GST</label>
        <div>
            {{ form_widget(form.gst) }}
            {{ form_errors(form.gst) }}
        </div>
    </div>
</div>
<div class="row">
    {% if editProduct.image %}
        <div id="image-dialog" class="d-none">
            <img src="{{ asset('product/' ~ editProduct.image) }}" alt="View" style="width:100%;">
        </div>
        <div class="col-lg-12 col-md-4 d-none" id="uploadImage">
            <label for="product_image" class="form-label">Upload image</label>
            <div class="mb-3">
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>
        </div>
        <div class="col-lg-12 col-md-4" id="updateImage">
            <label for="product_image" class="form-label">Update image</label>
            <div class="col-lg-8 col-md-4" id="image-slot">
                <div class="col-lg-6 position-relative">
                    <img src="{{ asset('product/' ~ editProduct.image) }}"
                         class="img-fluid w-25 h-50 border border-black rounded" id="uploadedImage">
                </div>
                <div>
                    <ul class="list-unstyled mb-2" style=" margin-left: 35px" id="imageUpdateButtons">
                        <li>
                            <a class="text-success opacity-75" id="viewImage">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </li>
                        <li>
                            <a class="text-danger opacity-75" id="trashImage">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-lg-12 col-md-4">
            <label for="product_image" class="form-label">Upload image</label>
            <div class="mb-3">
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>
        </div>
    {% endif %}
</div>
{{ form_end(form) }}
