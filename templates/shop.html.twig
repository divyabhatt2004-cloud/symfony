{% extends 'base.html.twig' %}
{% block body %}
    <section class=" pt-5 pb-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="card shadow">
                        <div class="card-body">
                            <ul class="list-unstyled">
                                <li>
                                    <a class="d-flex justify-content-between text-decoration-none border-0 text-success pb-2"
                                       href="{{ path('shop') }}">Product</a>
                                </li>
                                <li>
                                    <a class="d-flex justify-content-between text-decoration-none text-success border-0 pb-2">Categories
                                        <i class="fa-solid fa-circle-chevron-down text-black" id="categoryDropdown"></i>
                                    </a>

                                </li>
                                <li id="categoryList" class="row mb-1 d-none">
                                    <ul class="list-unstyled">
                                        {% if categoryLists|length > 0 %}
                                            {% for categoryList in categoryLists %}
                                                <li>{{ categoryList.name }}</li>
                                            {% endfor %}
                                        {% else %}
                                            <p class="text-center">No category found</p>
                                        {% endif %}
                                    </ul>
                                </li>
                                <li>
                                    <a class="d-flex justify-content-between text-decoration-none text-success border-0">Gender
                                        <i class="fa-solid fa-circle-chevron-down text-black" id="genderDropdown"></i>
                                    </a>
                                </li>
                                <li id="genderList" class="row d-none">
                                    <ul class="list-unstyled">
                                        <li class="row ms-1">Men</li>
                                        <li class="row ms-1">Women</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="container">
                        <div class="row mb-3 mt-3">
                            <div class="col-6">
                                <p class="h3 fw-light">All Men's Women's</p>
                            </div>
                            <div class="col-6">
                                <select class="form-control " name="cate" id="cate">
                                    <option selected>Featured</option>
                                    <option>AtoZ</option>
                                    <option>item</option>
                                </select>
                            </div>
                        </div>
                        {% if productLists|length > 0 %}
                            <div class="row text-center">
                                {% for productList in productLists %}
                                    <div class="col-lg-4 col-sm-6 mb-5" id="product">
                                        <div class="card product-wap mb-4 rounded-0" id="productCard">
                                            <div class="position-relative">
                                                <img src="{{ asset('product/' ~ productList.image) }}"
                                                     class="card-img rounded-0 img-fluid">
                                                <ul class="list-unstyled start-0 end-0" id="actionButtons">
                                                    <li>
                                                        {% if productList.wishlist == 0 %}
                                                            <a data-action="add2wishlist"
                                                               data-url="{{ path('add_to_wishlist',{'id':productList.id}) }}"
                                                               href="javascript:void(0)"
                                                               class="text-white btn btn-success opacity-75 p-2 border-0 mb-1 rounded">
                                                                <i class="fa-regular fa-heart"></i>
                                                            </a>
                                                        {% else %}
                                                            <a data-action="removeFromWishlist"
                                                               data-url="{{ path('remove_from_wishlist',{'id':productList.id}) }}"
                                                               href="javascript:void(0)"
                                                               class="text-white btn btn-success opacity-75 p-2 border-0 mb-1 rounded">
                                                                <i class="fa-solid fa-heart"></i>
                                                            </a>
                                                        {% endif %}
                                                    </li>
                                                    <li>
                                                        <a href="{{ path('product_details',{'id':productList.id}) }}"
                                                           class="text-white btn btn-success opacity-75 p-2 border-0 mb-1 rounded">
                                                            <i class="fa-solid fa-eye"></i>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="text-white btn btn-success opacity-75 p-2 border-0 mb-1 rounded"
                                                           data-action="add2Cart"
                                                           data-id="{{ productList.id }}"
                                                           data-quantity="1"
                                                           href="javascript:void(0)">
                                                            <i class="fa-solid fa-cart-plus"></i>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <div class="card-body p-2 bg-white">
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <p class=" h3 text-start card-title fw-light">{{ productList.name }}</p>
                                                        <p class="card-text text-start">{{ productList.description }}</p>
                                                    </div>
                                                </div>
                                                <div class="row mt-2">
                                                    <div class="col align-self-center">
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                        <i class="fa-duotone fa-solid fa-star text-secandary opacity-50"></i>
                                                        <i class="fa-duotone fa-solid fa-star text-secandary opacity-50"></i>
                                                    </div>
                                                </div>
                                                <div class="row mt-2 text-center fw-lighter pt-1">
                                                    <p class="h6 fw-light">${{ productList.price }}.00</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center"> No result found</td>
                            </tr>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

