{% if productCartLists|length > 0 %}
<div>
    <table class="table w-100">
        <thead>
        <tr>
            <th>Sno</th>
            <th>Product_name</th>
            <th width="150">Image</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total Gst Applied</th>
            <th>Net Price</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for productCartList in productCartLists %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ productCartList.productName }}</td>
                <td><img src="{{ asset('product/' ~ productCartList.productImage) }}" class="img-fluid w-50"></td>
                <td>{{ productCartList.productDescription }}</td>
                <td>{{ productCartList.quantity }}</td>
                <td>{{ productCartList.price }}</td>
                <td>{{ ((productCartList.quantity * productCartList.price) * productCartList.gst)/100 }}</td>
                <td>{{ (((productCartList.quantity * productCartList.price) * productCartList.gst)/100) +
                (productCartList.quantity * productCartList.price) }}</td>
                <td>
                    <a class="text-success ms-2" href="{{ path('product_details',{'id':productCartList.productId}) }}">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <a class="text-danger ms-2" href="{{ path('delete_from_cart',{'id':productCartList.productId}) }}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="row mt-5 d-none">
        <div class="col-4 offset-8">
            <div class="card mb-5">
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-6 text-start">
                            <p class="h6 fw-light">Net Product</p>
                            <p class="h6 fw-light">Net Quantity</p>
                            <p class="h6 fw-light">Grand_Total</p>
                        </div>
                        <div class="col-6 text-end">
                            <div>

                            </div>
                            <div>

                            </div>
                            <div>

                            </div>
                            <div class="mt-2">
                                <a class="btn btn-success text-white" href="cart_Checkout.php">Checkout</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6 text-center">
        <div class="card shadow pt-5 pb-5">
            <div class="card-body">
                <p class="h1 text-success">Cart is empty!</p>
                <a class="btn btn-success p-2 mt-2" href="{{ path('shop') }}">Shopping</a>
            </div>
        </div>
    </div>
</div>
{% endif %}
