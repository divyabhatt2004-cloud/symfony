{% extends 'base.html.twig' %}
{% block body %}
    <div class="container p-5">
       <div class="card rounded-0">
           <div class="card-body p-5">
               <div class="row text-center mt-3 pb-2">
                   <p class="h1">{{ titleType|default('Add product') }}</p>
               </div>
               <div class="row" id="productForm">
                   {{ form_start(form) }}
                   {#            <form method="post" class="mt-5 mb-5" enctype="multipart/form-data"> #}
                   <div class="row">
                       <div class="col-lg-6 col-md-4">
                           <label for="product_name" class="form-label">Product Name</label>
                           <div class="mb-3">
                               {{ form_widget(form.productName,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.productName) }}
                           </div>
                       </div>

                       <div class="col-lg-6 col-md-4">
                           <label for="product_image" class="form-label">Upload image</label>
                           <div class="mb-3">
                               {{ form_widget(form.productImage,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.productImage) }}
                           </div>
                       </div>
                   </div>
                   <div class="row">
                       <div class="col-lg-6 col-md-4">
                           <label for="quantity" class="form-label">Quantity</label>
                           <div class="mb-3">
                               {{ form_widget(form.quantity,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.quantity) }}
                           </div>
                       </div>

                       <div class="col-lg-6 col-md-4">
                           <label for="category" class="form-label">Categories</label>
                           <div>
                               {{ form_widget(form.category,{'attr':{'class':'form-select'}}) }}
                               {{ form_errors(form.category) }}
                           </div>
                       </div>
                   </div>
                   <div class="row">
                       <div class="col-lg-6 col-md-4">
                           <label for="price" class="form-label">Price</label>
                           <div class="mb-3">
                               {{ form_widget(form.price,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.price) }}
                           </div>
                       </div>
                       <div class="col-lg-6 col-md-4">
                           <label for="gst" class="form-label">GST</label>
                           <div class="mb-3">
                               {{ form_widget(form.gst,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.gst) }}
                           </div>
                       </div>
                   </div>
                   <div class="row">
                       <div class="col-lg-12 col-md-8">
                           <label for="product_description" class="form-label">Description</label>
                           <div class="mb-3">
                               {{ form_widget(form.productDescription,{'attr':{'class':'form-control'}}) }}
                               {{ form_errors(form.productDescription) }}
                           </div>
                       </div>
                   </div>
                   <div class="col-6 offset-6 text-end pt-2 mt-4">
                       <input type="submit" class="btn btn-success text-white fs-5" name="save" value="SAVE"></input>
                   </div>
                   {{ form_end(form) }}
               </div>
           </div>
       </div>
    </div>
{% endblock %}
