{% extends 'base.html.twig' %}
{% block body %}
    <div class="container p-5">
        <div class="row text-center mt-3">
            <p class="h1">Category</p>
        </div>
        <div class="row">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-lg-6 col-md-4">
                        <label for="cname" class="form-label">Category Name</label>
                        <div class="mb-3">
                            {{ form_widget(form.categoryName,{'attr':{'class':'form-control'}}) }}
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-4">
                        <label for="type" class="form-label">Category Type</label>
                        <div class="mb-3">
                            {{ form_widget(form.categoryType,{'attr':{'class':'form-control'}}) }}
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-4">
                        <label for="desc" class="form-label">Description</label>
                        <div class="mb-3">
                            {{ form_widget(form.categoryDescription,{'attr':{'class':'form-control'}}) }}
                        </div>
                    </div>
                    <div class="col-6 text-end pt-2 mt-4">
                        <input type="submit" class="btn btn-success text-white fs-5" name="create_category" value="SAVE"></input>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
