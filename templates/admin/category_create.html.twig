{% extends 'base.html.twig' %}
{% block body %}
    <div class="container p-5">
        <div class="card rounded-0 ">
            <div class="card-body p-5">
                <div class="row text-center mt-3 pb-2">
                    <p class="h1">Create Category</p>
                </div>
                {{ form_start(form) }}
                <div class="row">
                    {% include 'formLayout/category_form.html.twig' with {'form': form} %}
                    <div class="col-6 text-end pt-2 mt-4">
                        <input type="submit" class="btn btn-success text-white fs-5" name="create_category" value="SAVE"></input>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
