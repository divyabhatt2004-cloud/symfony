{% extends 'admin/inner_nav.html.twig' %}
{% block innerCardBody %}
    <div class="row text-end border-bottom pb-2">
        <div class=" offset-10 col-lg-2">
            <button class="btn btn-success"><a href="{{ path('category_create') }}" class="text-white text-decoration-none">Create
                    <i class="fa-solid fa-circle-plus"></i></a></button>
        </div>
    </div>
    <div>
        <table class="table">
            <thead>
            <tr>
                <th>Srno</th>
                <th>Category name</th>
                <th>Category type</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            {% if categoryLists|length > 0 %}
            {% for categoryList in categoryLists %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ categoryList.categoryName }}</td>
                    <td>{{ categoryList.categoryType }}</td>
                    <td>{{ categoryList.categoryDescription }}</td>
                    <td><a class="text-success ms-2" href="{{ path('update-category',{'id':categoryList.id}) }}"><i
                                class="fa-solid fa-pen"></i></a> <a class="text-danger ms-2"
                                                                    href="{{ path('delete-category',{'id':categoryList.id}) }}"><i
                                class="fa-solid fa-trash-can"></i></a></td>
                </tr>
            {% endfor %}
            {% else %}
                <tr>
                    <td colspan="5" class="text-center"> No result found</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}
