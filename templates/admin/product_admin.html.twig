{% extends 'admin/inner_nav.html.twig' %}

{% block innerCardBody %}
    <div class="row text-end border-bottom pb-2">
        <div class=" offset-10 col-lg-2">
            <button class="btn btn-success"><a href="/product-create" class="text-white text-decoration-none">Create
                    <i class="fa-solid fa-circle-plus"></i></a></button>
        </div>
    </div>
    <div>
        <table class="table">
            <thead>
            <tr>
                <th>Srno</th>
                <th>Product_name</th>
                <th>Image</th>
                <th>Description</th>
                <th>Quantity</th>
                <th>Category</th>
                <th>Price</th>
                <th>GST</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            {% if productLists|length > 0 %}
            {% for productList in productLists %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ productList.productName }}</td>
                    <td>{{ productList.productImage }}</td>
                    <td>{{ productList.productDescription }}</td>
                    <td>{{ productList.quantity }}</td>
                    <td>{{ productList.category }}</td>
                    <td>{{ productList.price }}</td>
                    <td>{{ productList.gst }}</td>
                    <td>
                        <a class="text-success ms-2" href="{{ path('update-product',{'id':productList.id}) }}"><i
                                class="fa-solid fa-pen"></i></a>
                        <a class="text-danger" href="{{ path('delete-product',{'id':productList.id}) }}"><i
                                class="fa-solid fa-trash-can"></i></a>
                    </td>
                </tr>
            {% endfor %}
            {% else %}
                <tr>
                    <td colspan="9" class="text-center"> No result found</td>
                </tr>
            {% endif %}

            </tbody>
        </table>
    </div>
{% endblock %}
