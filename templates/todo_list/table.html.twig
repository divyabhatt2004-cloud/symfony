<table class="table">
    <thead>
    <tr>
        <th>Sno</th>
        <th>Title</th>
        <th>Description</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    {% if todoLists|length > 0 %}
        {% for  todoList in todoLists %}
            <tr>
                <td>{{ todoList.title }}</td>
                <td>{{ todoList.description }}</td>
                <td>
                    <button class="btn btn-info" data-type="popup" data-edit="form">Edit</button>
                </td>
            </tr>
        {% endfor %}
        {% else %}
            <tr>
                <td colspan="4" class="text-center"> No result found</td>
            </tr>
    {% endif %}
    </tbody>
</table>

