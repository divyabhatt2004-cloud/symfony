{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        {{ form_start(form) }}
        <div class="card my-3">
            <div class="card-body">
                <h1 class="text-center">{{ titleType|default('Create Todo-list') }}</h1>
                <div class="row my-3">
                    <div class="col-md-2">
                        Title
                    </div>
                    <div class="col-md-9">
                        {{ form_widget(form.title,{'attr':{'class':'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-2">
                        Description
                    </div>
                    <div class="col-md-9">
                        {{ form_widget(form.description,{'attr':{'class':'form-control'}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-12 text-center">
                        <button type="submit" class="btn btn-success">Submit</button>
                    </div>

                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

