{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-12 border-bottom border-primary text-end pb-2">
                        <a href="{{ path('create_todo_list') }}" class="btn btn-success">Create</a>
                    </div>
                </div>

                <table class="table">
                    <thead>
                    <tr>
                        <th>sno</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for todoList in todoLists %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ todoList.title }}</td>
                            <td>{{ todoList.description }}</td>
                            <td>
                                <a href="{{ path('edit_todo_list',{'id':todoList.id}) }}" class="btn btn-success">edit</a>
                                <a href="{{ path('delete_todo_list',{'id':todoList.id}) }}" class="btn btn-danger">delete</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block title %}

{% endblock %}

